rules_version = '2';

// LEXFIT Firestore security rules.
// Content (videos, programs + sessions, filters) is read-only to signed-in
// users and written only by the server/seed (Admin SDK bypasses rules). Paid
// gating is NOT enforced here — content metadata (incl. muxPlaybackId) is
// readable, but playback requires a server-issued signed Mux URL. Each user can
// touch only their own users/{uid} subtree; subscription is server-write-only.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── Content: read-only to signed-in users ──
    match /videos/{code}      { allow read: if isSignedIn(); allow write: if false; }
    match /filters/{key}      { allow read: if isSignedIn(); allow write: if false; }
    match /programs/{slug} {
      allow read: if isSignedIn();
      allow write: if false;
      match /sessions/{sessionId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    // ── Per-user subtree (owner-only) ──
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid);
      allow delete: if false;

      match /onboarding/{doc} { allow read, write: if isOwner(uid); }
      match /progress/{doc}   { allow read, write: if isOwner(uid); }
      match /photos/{doc}     { allow read, write: if isOwner(uid); }
      match /myList/{doc}     { allow read, write: if isOwner(uid); }

      // Subscription is mirrored from Stripe by the server only.
      match /subscription/{doc} { allow read: if isOwner(uid); allow write: if false; }
    }

    // ── Default: deny everything else ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
