rules_version = '2';

// LEXFIT Storage security rules.
// Progress photos / avatars live under users/{uid}/… and are private to the
// owner. Body-image sensitive — locked down. Everything else is denied.
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Per-user private files (progress photos at milestones, avatar).
    match /users/{uid}/{allPaths=**} {
      allow read: if isOwner(uid);
      // Tightened in Phase 5: limit to images and a max size.
      allow write: if isOwner(uid);
    }

    // Default deny.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
