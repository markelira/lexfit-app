{
  "name": "lexfit_app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "next dev",
    "dev:local": "NEXT_PUBLIC_USE_EMULATORS=true FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199 next dev",
    "emulators": "firebase emulators:start --only auth,firestore,storage --import=./.emulator-data --export-on-exit",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "node --env-file=.env.local scripts/seed.mjs",
    "seed:local": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 node --env-file=.env.local scripts/seed.mjs",
    "seed:stripe": "node --env-file=.env.local --import tsx scripts/seed-stripe.ts",
    "test:pricing": "node --import tsx scripts/pricing-selftest.ts",
    "test:funnel": "node --import tsx scripts/funnel-selftest.ts",
    "test:onboarding-draft": "node --import tsx scripts/onboarding-draft-selftest.ts",
    "healthcheck": "node --env-file=.env.local scripts/firebase-healthcheck.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mux/mux-node": "^14.1.1",
    "@mux/mux-player-react": "^3.13.0",
    "@mux/mux-uploader-react": "^1.5.0",
    "@stripe/stripe-js": "^9.8.0",
    "firebase": "^12.15.0",
    "firebase-admin": "^13.10.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "stripe": "^22.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
