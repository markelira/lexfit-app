rules_version = '2';

// LEXFIT Firestore security rules.
// Model: content collections are read-only to signed-in users and written only
// by the server/seed (Admin SDK bypasses rules). Each user can touch only their
// own users/{uid} subtree. Subscription status is written by the server only.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── Content authored by you / seeded (read-only to signed-in users) ──
    match /programs/{doc}     { allow read: if isSignedIn(); allow write: if false; }
    match /workouts/{doc}     { allow read: if isSignedIn(); allow write: if false; }
    match /bonusContent/{doc} { allow read: if isSignedIn(); allow write: if false; }
    match /filters/{doc}      { allow read: if isSignedIn(); allow write: if false; }

    // ── Per-user subtree (owner-only) ──
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid);
      allow delete: if false;

      // Owner-writable personal data.
      match /onboarding/{doc} { allow read, write: if isOwner(uid); }
      match /progress/{doc}   { allow read, write: if isOwner(uid); }
      match /photos/{doc}     { allow read, write: if isOwner(uid); }
      match /myList/{doc}     { allow read, write: if isOwner(uid); }

      // Subscription is mirrored from Stripe by the server only. Owners may read
      // their status; clients may never write it.
      match /subscription/{doc} { allow read: if isOwner(uid); allow write: if false; }
    }

    // ── Default: deny everything else ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
