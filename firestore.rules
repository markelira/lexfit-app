rules_version = '2';

// LEXFIT Firestore security rules.
// Content (videos, programs + sessions, filters) is read-only to signed-in
// users and written only by the server/seed (Admin SDK bypasses rules). Paid
// gating is NOT enforced here — content metadata (incl. muxPlaybackId) is
// readable, but playback requires a server-issued signed Mux URL. Each user can
// touch only their own users/{uid} subtree; subscription is server-write-only.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    // A prefs write is valid if it doesn't set a malformed reminder time. Other
    // fields are owner-trusted; the essential guarantee is owner-only access.
    function validReminderTime() {
      let d = request.resource.data;
      return !('reminders' in d) || !('workout' in d.reminders) || !('time' in d.reminders.workout)
        || (d.reminders.workout.time is string
            && d.reminders.workout.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'));
    }

    // ── Content: read-only to signed-in users ──
    match /videos/{code}      { allow read: if isSignedIn(); allow write: if false; }
    match /filters/{key}      { allow read: if isSignedIn(); allow write: if false; }
    match /programs/{slug} {
      allow read: if isSignedIn();
      allow write: if false;
      match /sessions/{sessionId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    // ── Kihívások (Szavazz Magadra archive): read-only, server/seed-written ──
    match /challengeVideos/{code}  { allow read: if isSignedIn(); allow write: if false; }
    match /challengeFilters/{key}  { allow read: if isSignedIn(); allow write: if false; }
    match /challenges/{slug} {
      allow read: if isSignedIn();
      allow write: if false;
      match /days/{dayId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }
    // Global app settings (e.g. settings/challenges → { fbGroupUrl }): read-only.
    match /settings/{doc}          { allow read: if isSignedIn(); allow write: if false; }

    // Finish-share handoff sessions (desktop→phone). The token is the doc id;
    // the owner (desktop) may read/listen to their own session for live status.
    // All writes are server-only (Admin SDK); the phone talks via the API, never
    // the client SDK. Holds only workout stats + status — never the selfie.
    match /shareSessions/{token} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // ── Per-user subtree (owner-only) ──
    match /users/{uid} {
      allow read: if isOwner(uid);
      // deletionRequestedAt is set only by the server (P6.2 account-deletion flow);
      // the owner may never write it.
      allow create: if isOwner(uid) && !('deletionRequestedAt' in request.resource.data);
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['deletionRequestedAt']);
      allow delete: if false;

      match /onboarding/{doc} { allow read, write: if isOwner(uid); }
      match /progress/{doc}   { allow read, write: if isOwner(uid); }
      match /photos/{doc}     { allow read, write: if isOwner(uid); }
      match /myList/{doc}     { allow read, write: if isOwner(uid); }
      // Kihívások completion store — owner-only (separate from Foundation progress).
      match /challengeProgress/{doc} { allow read, write: if isOwner(uid); }
      // Profile settings (settings/prefs) — owner-only; reminder time validated.
      match /settings/{doc}   { allow read: if isOwner(uid); allow write: if isOwner(uid) && validReminderTime(); }
      // Consent records are written server-side at checkout (auditable proof).
      match /consents/{doc}   { allow read: if isOwner(uid); allow write: if false; }

    }

    // ── Pricing system: server (Admin SDK) writes only ──
    // subscriptions/{uid} is the single source of truth for access; the owner
    // may read it. Check-ins/offers carry a userId field for owner reads.
    // Docs are keyed {uid}_… so the id prefix identifies the owner.
    match /subscriptions/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }
    match /checkins/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
    match /offers/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
    match /milestones/{docId} { allow read, write: if false; }
    match /stripeWebhookEvents/{eventId} { allow read, write: if false; }

    // ── Default: deny everything else ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
