# ─────────────────────────────────────────────────────────────
# LEXFIT — environment variable template.
# Copy to .env.local and fill in real values (never commit .env.local).
# Every variable here must also be set in Vercel → Settings → Env Vars.
# ─────────────────────────────────────────────────────────────

# Firebase Web SDK (client) — safe to expose to the browser
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server only) — from the service-account JSON.
# Store the private key on one line with literal \n; code restores newlines.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Mux (server only)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
MUX_WEBHOOK_SECRET=

# Stripe (Phase 6) — use TEST keys in dev
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Transactional email (SendGrid) — F2.2 reminders, F3 offer notices, F5.1
# dunning. Without these, sends are logged & skipped (dev). EMAIL_FROM must be a
# verified SendGrid sender identity, or sends return 403.
SENDGRID_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=
# Vercel Cron auth — the daily reminders job checks this Bearer token.
CRON_SECRET=

# Billingo (F0.6) — NAV-compliant invoicing on invoice.paid / one-off payment.
# Without these, invoice issuance is logged & skipped (dev). BILLINGO_BLOCK_ID
# is the document block configured in your Billingo account.
BILLINGO_API_KEY=
BILLINGO_BLOCK_ID=

# ── Pricing system ("Kiérdemelt Ár") — OPTIONAL overrides ──────────────────
# Every price / window / threshold lives in src/lib/pricing/config.ts with a
# sane default; set any of these ONLY to A/B a value without a code deploy.
# Prices are gross HUF. Run `npm run seed:stripe` after changing an amount.
#   Amounts:   PRICE_WEEK_INTRO, PRICE_WEEK_STD, PRICE_WEEK_ONEOFF,
#              PRICE_MONTH_STD, PRICE_MONTH_ONEOFF, PRICE_ANNUAL_STD,
#              PRICE_ANNUAL_EARNED, PRICE_MONTH_FOUNDER, PRICE_ANNUAL_RENEW,
#              PRICE_BIENNIAL_RENEW, PRICE_ANNUAL_WINBACK
#   Windows:   PRICING_EARNING_WINDOW_DAYS, PRICING_EARNING_REQUIRED_CHECKINS,
#              PRICING_GRAND_SLAM_HOURS, PRICING_WEEK_INTRO_DAYS,
#              PRICING_DUNNING_GRACE_DAYS, PRICING_FOUNDER_LOCK_MONTHS, …
# (see config.ts for the full list)

# ── App / dev flags ─────────────────────────────────────────
# Canonical public origin of the deployed app. Used server-side as the
# fallback for Stripe return URLs when the Origin header is absent.
# Set to the real domain in Vercel production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Point the browser SDK at the Local Emulator (auth/firestore/storage).
# Set automatically by `npm run dev:local`. MUST be unset (or not "true")
# in every Vercel environment.
# NEXT_PUBLIC_USE_EMULATORS=true

# Firebase App Check — reCAPTCHA v3 PUBLIC site key (starts with 6L…). Enables
# App Check in the browser (skipped under the emulator; inert if unset). The
# reCAPTCHA SECRET stays in the Firebase console, never here. Keep every App
# Check service UNENFORCED until this is deployed and tokens appear in
# monitoring, then enforce.
NEXT_PUBLIC_APPCHECK_RECAPTCHA_SITE_KEY=

# Optional: override the shared Mux test playback id used by the emulator
# attach scripts (scripts/attach-emulator-*.mjs).
# MUX_TEST_PLAYBACK=

# Billingo invoice VAT code. Default "AAM" (alanyi adómentes). Set to "27%"
# only if/when the company becomes VAT-registered.
# BILLINGO_VAT_CODE=AAM

# ── Error monitoring (Sentry) ───────────────────────────────
# Both optional — monitoring is inert until set. Create the project at
# sentry.io (platform: Next.js), then set BOTH to the project DSN.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# Source-map upload at build time (withSentryConfig in next.config.ts). Without
# all three the build still succeeds but prod stack traces stay minified
# ("page.tsx:325 in tu"). Set them in Vercel for every environment; the auth
# token is an org token with project:releases scope — never commit it.
# SENTRY_ORG=am-studios-group-kft
# SENTRY_PROJECT=javascript-nextjs
# SENTRY_AUTH_TOKEN=

# Analytics / SEO (optional — features stay off when unset)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
