rules_version = '2';

// LEXFIT Storage security rules.
// Progress photos / avatars live under users/{uid}/… and are private to the
// owner. Body-image sensitive — locked down. Everything else is denied.
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Per-user private files (progress photos at milestones, avatar).
    // Images only, max 10 MB — without this any authed user could park
    // unlimited arbitrary files here (billing/abuse surface).
    match /users/{uid}/{allPaths=**} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Default deny.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
